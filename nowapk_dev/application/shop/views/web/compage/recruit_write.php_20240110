													var rc_workValues = rc_work.split(',');
													for (var i = 0; i < work_checkboxes.length; i++) {
													    if (rc_workValues.includes(work_checkboxes[i].value)) {
													        work_checkboxes[i].checked = true;
													    }else{
													        work_checkboxes[i].checked = false;
														}
													}

