                                    <p class="form-label">채용공고기간</p>
                                    <div class="value">
                                        <div class="inline-group">
                                            <div class="recruit-range">
                                                <label>
                                                    <span class="sr-text">채용공고기간 입력</em></span>
                                                    <input type="text" name="rc_date" aria-required="true" required class="form-text js-datepicker2">
