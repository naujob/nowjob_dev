													for (var i = 0; i < work_type_checkboxes.length; i++) {
													    if (rc_work_typeValues.includes(work_type_checkboxes[i].value)) {
													        work_type_checkboxes[i].checked = true;
													    }else{
													        work_type_checkboxes[i].checked = false;
													    }
