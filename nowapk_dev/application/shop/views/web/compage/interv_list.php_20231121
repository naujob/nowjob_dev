</template>

<script>
    $(".btnSave1").click(function(){
        var mm_name = $(this).data("mm_name");
        var iv_idx = $(this).data("iv_idx");

        openPopup('confirm', {
            content: '<em>“'+mm_name+'”</em> 님을<br> 채용하셨습니까?',
            firstButton: '면접불참',
            secondButton: '미채용',
            thirdButton: '채용',
            firstCallback: function () {
                chageStatus(iv_idx,"면접불참");
            },
            secondCallback: function () {
                chageStatus(iv_idx,"미채용");
            },
            thirdCallback: function () {
                chageStatus(iv_idx,"채용확정");
            }
        });
    });

    $(".btnSave2").click(function(){
        var mm_name = $(this).data("mm_name");
        var iv_idx = $(this).data("iv_idx");

        openPopup('confirm', {
            content: '<em>“'+mm_name+'”</em> 님이<br> 출근하셨습니까?',
            firstButton: '미출근',
            secondButton: '출근',
            firstCallback: function () {
                chageStatus(iv_idx,"미출근");
            },
            secondCallback: function () {
                var content = document.querySelector('#startDateTemp').innerHTML;
                openPopup('modal', {
                    title: '출근일자 입력',
                    content: content,
                    firstButton: '입력',
                    firstCallback: function () {
                        chageStatusDate(iv_idx,"출근",$("[name='interviewDate']").val());
                    },
                });

                /* 달력표시 */
                function chgMonth (instance) {
                    var $con = instance.calendarContainer.querySelector('.flatpickr-month'),
                        month = Number(instance.currentMonth) + 1,
                        year = instance.currentYear;
                    $con.innerHTML = '<span class="month">' + month + '<small>월</small></span><span class="year">' + year + '</span>';
                }

                if (typeof flatpickr == 'undefined') return false;

                //달력 생성
                calendars = flatpickr('.js-datepicker', {
                    inline: true,
                    locale: 'ko',
                    dateFormat: 'Y-m-d',
                    ariaDateFormat: 'Y-m-d',
                    altInput: true,
                    nextArrow: '<span class="sr-text">다음</span>',
                    prevArrow: '<span class="sr-text">이전</span>',
                    disableMobile: true,
                    onChange: function (selectedDates, dateStr, instance) {
                        if(!dateStr) return;
                        var dayTxt = new Date(selectedDates).getDay();
                        var dayArr = ['일','월','화','수','목','금','토'];
                        instance.element.parentNode.querySelector('.js-date-value').value = dateStr +'('+ dayArr[dayTxt]+')';
                    },
                    onMonthChange: function (selectedDates, dateStr, instance) {
                        chgMonth(this);
                    },
                    onDayCreate: function(dObj, dStr, fp, dayElem){
                        var day = new Date(dayElem.getAttribute('aria-label')).getDay();
                        if (day == 0) {
                            dayElem.classList.add('sun');
                        } else if (day == 6) {
                            dayElem.classList.add('sat');
                        }
                    },
                    onReady: function () {
                        chgMonth(this);
                    }
                });
            }
        });
    });

    $(".btnSave3").click(function(){
        var mm_name = $(this).data("mm_name");
        var iv_idx = $(this).data("iv_idx");

        openPopup('confirm', {
            content: '<em>“'+mm_name+'”</em> 님이<br> 재직중인가요?',
            firstButton: '무단퇴사',
            secondButton: '퇴사',
            thirdButton: '재직중',
            firstCallback: function () {
                chageStatus(iv_idx,"무단퇴사");
            },
            secondCallback: function () {
                chageStatus(iv_idx,"퇴사");
            },
            thirdCallback: function () {
                chageStatus(iv_idx,"재직중");
            }
        });
    });

    $(".btnSave4").click(function(){
        var iv_idx = $(this).data("iv_idx");
        var params = {};
        params["iv_idx"] = iv_idx;
        comAjax("/compage_proc/interv_detail_ajax",params,function(ret){
            if(ret.code=="00"){
            	var data = ret.data.resume;
                var content = document.querySelector('#ratingFormTemp').innerHTML;
                content = content.replaceAll("{{src}}",data.src);
                content = content.replaceAll("{{category}}",data.category);
                content = content.replaceAll("{{ru_work_type}}",data.ru_work_type);
                content = content.replaceAll("{{mm_nation}}",data.mm_nation);
                content = content.replaceAll("{{ma_age}}",data.ma_age);
                content = content.replaceAll("{{week}}",data.week);
                content = content.replaceAll("{{mm_nation}}",data.mm_nation);
                content = content.replaceAll("{{mm_name}}",data.mm_name);
                content = content.replaceAll("{{ad_addr}}",data.ad_addr);
                content = content.replaceAll("{{eval_num}}",data.eval_num);
                content = content.replaceAll("{{mm_nation}}",data.mm_nation);
                content = content.replaceAll("{{eval_per}}",data.eval_per);
                
		        openPopup('modal', {
	                title: '인재평가',
	                content: content,
	                firstButton: '별점확인',
	                firstCallback: function () {
	                    if($("[name=rating1]").is(":checked")==false){
					        commonAlert("근무태도 별점을 선택해주세요.",function(){});
					        return;
					    }
					
					    if($("[name=rating2]").is(":checked")==false){
					        commonAlert("업무능력 별점을 선택해주세요.",function(){});
					        return;
					    }
					
					    if($("[name=rating3]").is(":checked")==false){
					        commonAlert("성향 별점을 선택해주세요.",function(){});
					        return;
					    }
					
					    var params = {};
					    params["iv_idx"] = iv_idx;
					    params["iv_eval_num1"] = $("[name=rating1]:checked").val();
					    params["iv_eval_num2"] = $("[name=rating2]:checked").val();
					    params["iv_eval_num3"] = $("[name=rating3]:checked").val();
					    params["iv_status"] = "평가완료";
					    comAjax("/compage_proc/chage_interview_proc",params,function(ret){
					        if(ret.code=="00"){
					            commonAlert("평가 완료 되었습니다.",function(){
					                location.reload();
					            });
					        }else{
					            commonAlert(ret.msg,function(){});
					        }
					    });
	                }
	            });
            }else{
            	commonAlert("인재정보를 조회 하지 못하였습니다. 관리자에 문의 바랍니다.",function(){});
            }
        });
    });

    function chageStatus(iv_idx,iv_status){
        var params = {};
        params["iv_idx"] = iv_idx;
        params["iv_status"] = iv_status;
        comAjax("/compage_proc/chage_interview_proc",params,function(ret){
            if(ret.code=="00"){
                location.reload();
            }else{
            	commonAlert(ret.msg,function(){});
            }
        });
    }

    function chageStatusDate(iv_idx,iv_status,dt){
        var params = {};
        params["iv_idx"] = iv_idx;
        params["iv_status"] = iv_status;
        params["iv_hire_dt"] = dt.substr(0,10);
        comAjax("/compage_proc/chage_interview_proc",params,function(ret){
            if(ret.code=="00"){
                location.reload();
            }else{
            	commonAlert(ret.msg,function(){});
            }
        });
    }
</script>
