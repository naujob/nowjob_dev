            }

			if($ru_price_type==""){
                json_return("99","희망급여 선택이 확인되지 않습니다.");
            }

			if($ru_work_type==""){
                json_return("99","근무형태 선택이 확인되지 않습니다.");
            }

            #로그 생성
            $sl_txt = [
            	"ru_name"=>$ru_name
                ,"ru_work"=>$ru_work
                ,"ru_addr"=>$ru_addr
                ,"ru_work_img"=>$ru_work_img=="" ? [] : explode(",",$ru_work_img)
