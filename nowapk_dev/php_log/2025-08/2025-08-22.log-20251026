
query(2025-08-22 07:42:37):

			SELECT 
			 aa.rc_idx,
 aa.mm_comp_name,
 aa.rc_name,
 aa.rc_work,
 aa.rc_work_type,
 aa.rc_price_type,
 aa.rc_price_rep,
 aa.rc_price_pay,
 aa.rc_work_dt,
 aa.rc_am_stime,
 aa.rc_am_etime,
 aa.rc_pm_stime,
 aa.rc_pm_etime,
 aa.rc_week,
 aa.rc_desc,
 aa.rc_life_type,
 aa.rc_hash,
 aa.ad_addr,
 aa.ad_gps_x,
 aa.ad_gps_y,
 aa.rc_thumb,
 aa.rc_img1,
 aa.rc_img2,
 aa.rc_img3,
 aa.rc_img4,
 aa.rc_img5,
 aa.rc_hit,
 aa.book_cnt,
 (case
        when rc_nation = '내국인,외국인' then '국적무관'
        when rc_nation = '내국인' then '내국인'
        when rc_nation = '외국인' then '외국인'
        else '국적무관' end) as rc_nation_nm,
 (case
        when rc_sage <> '' AND rc_eage <> '' then CONCAT(rc_sage, ' ~ ',rc_eage,'세')
        when rc_sage <> '' then CONCAT(rc_sage, '세 ~')
        when rc_eage <> '' then CONCAT(' ~ ', rc_eage, '세')
        else '나이무관' end) as rc_age_nm,
 (case
        when rc_sex = '남자,여자' then '성별무관'
        when rc_sex = '남자' then '남자'
        when rc_sex = '여자' then '여자'
        else '성별무관' end) as rc_sex_nm,
 (case when dd.bk_idx is not null then 'Y' else 'N' end) as book_yn,
 p0.pm_idx,
 p0.reg_dt as pm_reg_dt,
 GREATEST(case when aa.up_dt = '0000-00-00 00:00:00' then aa.reg_dt else aa.up_dt end, IFNULL(p.up_dt, '2000-01-01 00:00:00')) as up_dt
			 FROM 
            (/* querylog */
                SELECT aa.mm_id
                  ,aa.mm_status
                  ,bb.*
                  ,(SELECT count(*) as cnt FROM st_bookmark where bk_type = 'RECRUIT' AND bk_key = bb.rc_idx) as book_cnt
                  ,ifnull(min(po.pm_sdate),'2050-01-01 00:00:00') as max_date
                  ,cc.ad_addr
                  ,CONCAT(cc.ad_doro, ' ', cc.ad_jibun) AS s_addr
                  ,cc.ad_gps_x
                  ,cc.ad_gps_y
                  ,aa.mm_comp_num
                  ,aa.mm_comp_name
                  ,ROUND(
                    6371 * acos(
                    cos(radians(126.9780)) * cos(radians(cc.ad_gps_x)) * cos(radians(cc.ad_gps_y) - radians(37.5665)) +
                    sin(radians(126.9780)) * sin(radians(cc.ad_gps_x))
                    ), 1
                  ) AS distance                  
                FROM st_member aa
                INNER JOIN st_recruit_20250819 bb
                  ON aa.mm_idx = bb.mm_idx
                INNER JOIN st_address cc
                  ON aa.mm_idx = cc.mm_idx AND cc.ad_type = 'RECRUIT' AND cc.ad_key = bb.rc_idx
                LEFT JOIN st_promotion po
                  ON bb.rc_idx = po.rc_idx AND (po.pm_sdate <= now() AND po.pm_edate >= now())
                GROUP BY bb.rc_idx
            ) aa
			LEFT JOIN st_bookmark dd ON aa.rc_idx = dd.bk_key AND dd.bk_type = 'RECRUIT' AND dd.mm_idx = '-1'
		  LEFT JOIN st_promotion p0 ON p0.rc_idx = aa.rc_idx AND p0.pm_code = 'C001' AND p0.pm_sdate < NOW() AND p0.pm_edate > NOW() AND p0.pm_status = 'Y'  LEFT JOIN st_promotion p1 ON p1.rc_idx = aa.rc_idx AND p1.pm_code = 'C002' AND p1.pm_sdate < NOW() AND p1.pm_edate > NOW() AND p1.pm_status = 'Y'  LEFT JOIN st_promotion p2 ON p2.rc_idx = aa.rc_idx AND p2.pm_code = 'C003' AND p2.pm_sdate < NOW() AND p2.pm_edate > NOW() AND p2.pm_status = 'Y'  LEFT JOIN st_promotion p ON aa.rc_idx = p.rc_idx AND p.pm_code in('C002','C003') AND NOW() BETWEEN p.pm_sdate AND p.pm_edate 
			 WHERE 1=1 
  AND aa.mm_status = 'Y' AND aa.rc_show_yn = 'Y' AND aa.rc_status = 'Y' AND aa.rc_sdate <= now() AND aa.rc_edate >= now() 

            GROUP BY aa.rc_idx
			 order by  case when (case when ifnull(p0.pm_idx,0) > 0 then 1 else 0 end) = 1 then rand() else 0 end DESC,  GREATEST(case when aa.up_dt = '0000-00-00 00:00:00' then aa.reg_dt else aa.up_dt end, IFNULL(p.up_dt, '2000-01-01 00:00:00')) DESC 
			 LIMIT 0 , 20 
		

query(2025-08-22 10:08:17):

			SELECT 
			 aa.rc_idx,
 aa.rc_name,
 aa.rc_work,
 aa.rc_work_type,
 aa.rc_price_type,
 aa.rc_price_rep,
 aa.rc_price_pay,
 aa.rc_img1,
 group_concat(cc.ad_addr) as ad_addr,
 (case
        when rc_nation = '내국인,외국인' then '국적무관'
        when rc_nation = '내국인' then '내국인'
        when rc_nation = '외국인' then '외국인'
        else '국적무관' end) as rc_nation_nm,
 (case
        when rc_sage <> '' AND rc_eage <> '' then CONCAT(rc_sage, ' ~ ',rc_eage,'세')
        when rc_sage <> '' then CONCAT(rc_sage, '세 ~')
        when rc_eage <> '' then CONCAT(' ~ ', rc_eage, '세')
        else '나이무관' end) as rc_age_nm,
 (case when dd.bk_idx is not null then 'Y' else 'N' end) as book_yn
			 FROM 
			( /* querylog */
        SELECT aa.mm_id
          ,aa.mm_status
          ,bb.*
          ,(SELECT count(*) as cnt FROM st_bookmark where bk_type = 'RECRUIT' AND bk_key = bb.rc_idx) as book_cnt
          ,ifnull(min(po.pm_sdate),'2000-01-01 00:00:00') as max_date
          ,cc.ad_addr
        FROM st_member aa
        INNER JOIN st_recruit bb
          ON aa.mm_idx = bb.mm_idx
        INNER JOIN st_address cc
          ON aa.mm_idx = cc.mm_idx AND cc.ad_type = 'RECRUIT' AND cc.ad_key = bb.rc_idx
        LEFT JOIN (
					SELECT aa.*
					FROM st_promotion aa
					INNER JOIN (
            SELECT max(pm_idx) as max_idx ,rc_idx
            FROM st_promotion po
            where (po.pm_sdate <= now() AND po.pm_edate >= now()) AND po.pm_code = 'C001'
            group by rc_idx
          ) bb ON aa.pm_idx = max_idx
				) po ON bb.rc_idx = po.rc_idx
     where 1=1  AND bb.rc_idx = po.rc_idx 
        group by bb.rc_idx
      ) aa
			INNER JOIN st_address cc
				ON aa.mm_idx = cc.mm_idx AND cc.ad_type = 'RECRUIT' AND cc.ad_key = aa.rc_idx
			LEFT JOIN st_bookmark dd
				ON aa.rc_idx = dd.bk_key AND dd.bk_type = 'RECRUIT' AND dd.mm_idx = '-1'
			LEFT JOIN st_promotion p
				ON aa.rc_idx = p.rc_idx AND p.pm_code = 'C002' AND now() between p.pm_sdate AND p.pm_edate
		
			 WHERE 1=1 
  AND aa.mm_status = 'Y' AND aa.rc_show_yn = 'Y' AND aa.rc_status = 'Y' AND aa.rc_sdate <= now() AND aa.rc_edate >= now() 

            group by aa.rc_idx 
			 order by rand() 
			 LIMIT 0 ,  
		

query(2025-08-22 10:10:50):

			SELECT 
			 aa.rc_idx,
 aa.rc_name,
 aa.rc_work,
 aa.rc_work_type,
 aa.rc_price_type,
 aa.rc_price_rep,
 aa.rc_price_pay,
 aa.rc_img1,
 group_concat(cc.ad_addr) as ad_addr,
 (case
        when rc_nation = '내국인,외국인' then '국적무관'
        when rc_nation = '내국인' then '내국인'
        when rc_nation = '외국인' then '외국인'
        else '국적무관' end) as rc_nation_nm,
 (case
        when rc_sage <> '' AND rc_eage <> '' then CONCAT(rc_sage, ' ~ ',rc_eage,'세')
        when rc_sage <> '' then CONCAT(rc_sage, '세 ~')
        when rc_eage <> '' then CONCAT(' ~ ', rc_eage, '세')
        else '나이무관' end) as rc_age_nm,
 (case when dd.bk_idx is not null then 'Y' else 'N' end) as book_yn
			 FROM 
			( /* querylog */
        SELECT aa.mm_id
          ,aa.mm_status
          ,bb.*
          ,(SELECT count(*) as cnt FROM st_bookmark where bk_type = 'RECRUIT' AND bk_key = bb.rc_idx) as book_cnt
          ,ifnull(min(po.pm_sdate),'2000-01-01 00:00:00') as max_date
          ,cc.ad_addr
        FROM st_member aa
        INNER JOIN st_recruit bb
          ON aa.mm_idx = bb.mm_idx
        INNER JOIN st_address cc
          ON aa.mm_idx = cc.mm_idx AND cc.ad_type = 'RECRUIT' AND cc.ad_key = bb.rc_idx
        LEFT JOIN (
					SELECT aa.*
					FROM st_promotion aa
					INNER JOIN (
            SELECT max(pm_idx) as max_idx ,rc_idx
            FROM st_promotion po
            where (po.pm_sdate <= now() AND po.pm_edate >= now()) AND po.pm_code = 'C001'
            group by rc_idx
          ) bb ON aa.pm_idx = max_idx
				) po ON bb.rc_idx = po.rc_idx
     where 1=1  AND bb.rc_idx = po.rc_idx 
        group by bb.rc_idx
      ) aa
			INNER JOIN st_address cc
				ON aa.mm_idx = cc.mm_idx AND cc.ad_type = 'RECRUIT' AND cc.ad_key = aa.rc_idx
			LEFT JOIN st_bookmark dd
				ON aa.rc_idx = dd.bk_key AND dd.bk_type = 'RECRUIT' AND dd.mm_idx = '-1'
			LEFT JOIN st_promotion p
				ON aa.rc_idx = p.rc_idx AND p.pm_code = 'C002' AND now() between p.pm_sdate AND p.pm_edate
		
			 WHERE 1=1 
  AND aa.mm_status = 'Y' AND aa.rc_show_yn = 'Y' AND aa.rc_status = 'Y' AND aa.rc_sdate <= now() AND aa.rc_edate >= now() 

            group by aa.rc_idx 
			 order by rand() 
			 LIMIT 0 , 24 
		

