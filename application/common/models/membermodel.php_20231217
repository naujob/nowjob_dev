	function getRecruitTodayCnt($mm_idx){
		$sql = "
			select count(*) as cnt
			FROM st_recruit aa
			where aa.mm_idx = '$mm_idx'
			and date_format(reg_dt,'%Y%m%d') = date_format(now(),'%Y%m%d')
		";

		$query = $this->db->query($sql);
		$info = $query->row_array();
		if($info==null){
			return 0;
		}else{
			return $info["cnt"];
		}
	}

