                                                    <select name="category[]">
                                                        <?php foreach($ma_wrok_list as $row) : ?>
		                                               		<option value="<?=$row["cd_val"]?>" <?=equal_return($row["cd_val"],$arr_temp[0],"select")?>><?=$row["cd_val"]?></option>
		                                               	<?php endforeach;?>
                                                    </select>
                                                    <span class="liner"></span>
                                                </label>
