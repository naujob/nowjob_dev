                            </div>

                            <!--div class="form-row">
                                <p class="form-label">포트폴리오</p>
                                <div class="value">
                                    <div class="form-file js-show-filename">
                                        <input type="text" disabled class="form-text file-name">
                                        <label class="btn-round btn-tertiary">
                                            <span class="sr-text">파일 선택</span>
                                            <input type="file" name="portfolio" accept="image/*,.zip,.pdf">
                                            <span>첨부</span>
                                        </label>
                                    </div>
                                </div>
                            </div-->

                            <div class="form-row">
                                <p class="form-label"><span class="fixed">*</span>첨부사진</p>
                                <div class="value">
                                    <div class="form-pic-group">
                                        <label class="form-pic first">
                                            <input type="file" name="mm_img1" accept="image/*" class="js-file-preview">
                                            <span class="label">프로필 대표사진을<br> 첨부해주세요</span>
                                            <span class="preview"><!--미리보기--></span>
                                        </label>
                                        <label class="form-pic">
                                            <input type="file" name="mm_img2" accept="image/*" class="js-file-preview">
                                            <span class="preview"><!--미리보기--></span>
                                        </label>
                                        <label class="form-pic">
                                            <input type="file" name="mm_img3" accept="image/*" class="js-file-preview">
                                            <span class="preview"><!--미리보기--></span>
                                        </label>
                                        <label class="form-pic">
                                            <input type="file" name="mm_img4" accept="image/*" class="js-file-preview">
                                            <span class="preview"><!--미리보기--></span>
                                        </label>
                                        <label class="form-pic">
                                            <input type="file" name="mm_img5" accept="image/*" class="js-file-preview">
                                            <span class="preview"><!--미리보기--></span>
                                        </label>
                                    </div>
                                </div>
                                <p class="help-msg text-only">사진을 추가하시면 취업활동에 더 좋습니다.<br> 기본프로필을 사용시 면접에 영향이 갈수도 있습니다.</p>
                            </div>
                        </div>
                        <div class="form-action-wrap">
                            <button id="btnStep" type="button" class="btn-round btn-tertiary">미리보기</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main><!-- //page-content -->
</div><!-- //page -->


<script>
	$(document).ready(function(){
		//건너띄기
		$(".js-toggle-tooltip").click(function(){
			var params = {};
			params["ma_type"] = "MEM";
			params["proc_type"] = "PART";
			params["uuid"] = "<?=$uuid?>";
            comAjax("/member_proc/join_complete_proc",params,function(ret){
                if(ret.code=="00"){
                    location.href="/member/join_mem_finish";
                }else{
                    commonAlert(ret.msg,function(){});
                    return;
                }
            });
		});

        $("#btnPrev").click(function(){
			history.go(-1);
		});

        $("[name='ma_price_type[]']").click(function(){
            if($("[name='ma_price_type[]']:checked").length==3){
                $(this).closest(".form-group").find(".add_txt").show();
            }else{
                $(this).closest(".form-group").find(".add_txt").hide();
            }
        });

        $("[name='ma_work_type[]']").click(function(){
            if($("[name='ma_work_type[]']:checked").length==3){
                $(this).closest(".form-group").find(".add_txt").show();
            }else{
                $(this).closest(".form-group").find(".add_txt").hide();
            }
        });

		$("#btnStep").click(function(){
            if($("[name='ma_work[]']").is(":checked")==false){
            	commonAlert("희망업무를 선택해주세요.",function(){
            		$("[name='ma_work[]']").eq(0).focus();
            	});
            	return;
            }

            if($("[name='ma_price_type[]']").is(":checked")==false){
            	commonAlert("희망급여를 선택해주세요.",function(){
            		$("[name='ma_price_type[]']").eq(0).focus();
            	});
            	return;
            }

            if($("[name='ma_work_type[]']").is(":checked")==false){
            	commonAlert("근무형태를 선택해주세요.",function(){
            		$("[name='ma_work_type[]']").eq(0).focus();
            	});
            	return;
            }

            if($("[name='ma_week[]']").is(":checked")==false){
            	commonAlert("근무요일을 선택해주세요.",function(){
            		$("[name='ma_week[]']").eq(0).focus();
            	});
            	return;
            }

            if($("[name='ma_work_dt']").val()==""){
            	commonAlert("근무 희망일을 선택해주세요.",function(){
            		$("[name='ma_work_dt']").eq(0).focus();
            	});
            	return;
            }

            if($("[name='ma_edu']").is(":checked")==false){
            	commonAlert("최종학력을 선택해주세요.",function(){
            		$("[name='ma_edu']").eq(0).focus();
            	});
            	return;
            }

            if($("[name='ma_desc']").val()==""){
                commonAlert("자기소개 내용을 입력해주세요.",function(){});
                return;
            }

            if($("[name='mm_img1']").val()==""){
            	commonAlert("대표사진을 선택해주세요.",function(){
            		$("[name='mm_img1']").eq(0).focus();
            	});
            	return;
            }


            var arr_certi = "";
            for(var icnt=0;icnt < $("[name='license[]']").length;icnt++){
				if($("[name='license[]']").eq(icnt).val()!="" && $("[name='regdate[]']").eq(icnt).val()!=""){
	                if(arr_certi==""){
	                    arr_certi = $("[name='license[]']").eq(icnt).val() + "|||" + $("[name='regdate[]']").eq(icnt).val();
	                }else{
	                    arr_certi = arr_certi + "&&&" + $("[name='license[]']").eq(icnt).val() + "|||" + $("[name='regdate[]']").eq(icnt).val();
	                }
                }
            }
            $("[name=arr_certi]").val(arr_certi);

            var arr_career = "";
            for(var icnt=0;icnt < $("[name='category[]']").length;icnt++){
				if($("[name='category[]']").eq(icnt).val()!="" && $("[name='company[]']").eq(icnt).val()!="" && $("[name='period[]']").eq(icnt).val()!=""){
					if(arr_career==""){
	                    arr_career = $("[name='category[]']").eq(icnt).val() + "|||" + $("[name='company[]']").eq(icnt).val() + "|||" + $("[name='period[]']").eq(icnt).val();
	                }else{
	                    arr_career = arr_career + "&&&" + $("[name='category[]']").eq(icnt).val() + "|||" + $("[name='company[]']").eq(icnt).val() + "|||" + $("[name='period[]']").eq(icnt).val();
	                }
				}
            }
            $("[name=arr_career]").val(arr_career);

            var form = $('#frm');
            var params = new FormData(form[0]);
            fileAjaxLoading("/member_proc/join_wmem_step3",params,function(ret){
                if(ret.code=="00"){
                    showPreviewInfo(ret.data);
                }else{
                    commonAlert(ret.msg,function(){});
                    return;
                }
            });
		});

        $("[name=ma_week_yn]").click(function(){
			if($(this).is(":checked")){
				$("[name='ma_week[]']").prop("checked",true);
			}else{
				$("[name='ma_week[]']").prop("checked",false);
			}
		});

		$("[name='ma_week[]']").click(function(){
			if($("[name='ma_week[]']:checked").length == 7){
				$("[name=ma_week_yn]").prop("checked",true);
			}else{
				$("[name=ma_week_yn]").prop("checked",false);
			}
		});
	});

    function showPreviewInfo(info){

    	var str_ma_week = "";
    	var str_ma_career = "";
    	var str_ma_certi = "";
    	var str_ma_type = "";
    	var str_img = "";

    	if(info.ma_week){
	    	for(var icnt=0;icnt < info.ma_week.length;icnt++){
	    		str_ma_week += "<li aria-hidden='false'>"+info.ma_week[icnt]+"</li>";
	    	}
    	}

    	if(info.arr_career){
    		for(var icnt=0;icnt < info.arr_career.split("&&&").length;icnt++){
    			var temp = info.arr_career.split("&&&")[icnt].split("|||");
    			if(temp.length  > 2){
    				str_ma_career += "<li><span>"+temp[0]+"</span><span>"+temp[1]+"</span><em>"+temp[2]+"(1년 2개월)</em></li>";
    			}
	    	}
    	}

    	if(info.arr_certi){
    		for(var icnt=0;icnt < info.arr_certi.split("&&&").length;icnt++){
    			var temp = info.arr_certi.split("&&&")[icnt].split("|||");
    			if(temp.length  > 1){
    				str_ma_certi += "<li><span>자격증</span><span>"+temp[0]+"</span><em>"+temp[1]+"</em></li>";
    			}
	    	}
    	}

    	if(info.ma_my_type){
    		for(var icnt=0;icnt < info.ma_my_type.length;icnt++){
    			str_ma_type +="<p class='tag'>"+info.ma_my_type[icnt]+"</p>";
	    	}
    	}

    	if(info.mm_img1){
    		str_img += "<div class='pic-card'><img src='"+info.mm_img1+"' alt=''></div>";
    	}

    	if(info.mm_img2){
    		str_img += "<div class='pic-card'><img src='"+info.mm_img2+"' alt=''></div>";
    	}

    	if(info.mm_img3){
    		str_img += "<div class='pic-card'><img src='"+info.mm_img3+"' alt=''></div>";
    	}

    	if(info.mm_img4){
    		str_img += "<div class='pic-card'><img src='"+info.mm_img4+"' alt=''></div>";
    	}

    	if(info.mm_img5){
    		str_img += "<div class='pic-card'><img src='"+info.mm_img5+"' alt=''></div>";
    	}

        openPopup('modal', {
            content: '<div class="regist-info">'+
                    '<h5 class="name">'+info.mm_name+'</h5>'+
                    '<table>'+
                        '<caption><span class="sr-text">회원가입정보</span></caption>'+
                        '<colgroup><col><col></colgroup>'+
                        '<tbody>'+
                            '<tr>'+
                                '<td class="label">희망업무</td>'+
                                '<td class="value">'+
                                    info.ma_work_img +
                                    '</td>'+
                                    '</tr>'+
                                    '<tr>'+
                                '<td class="label">희망지역</td>'+
                                '<td class="value">'+info.ad_addr+'</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td class="label">급여형태</td>'+
                                '<td class="value">'+(info.ma_price_type.length > 2 ? "협의":info.ma_price_type)+'</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td class="label">근무형태</td>'+
                                '<td class="value">'+(info.ma_work_type.length > 2 ? "협의":info.ma_work_type)+'</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td class="label">근무희망요일</td>'+
                                '<td class="value">'+
                                    '<ul class="working-day">'+
                                        str_ma_week +
                                    '</ul>'+
                                '</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td class="label">근무희망일</td>'+
                                '<td class="value">'+info.ma_work_dt + '('+info.ma_work_dt_yoil+')' + '</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td class="label">최종학력</td>'+
                                '<td class="value">'+info.ma_edu+'</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td class="label">경력사항</td>'+
                                '<td class="value">'+
                                    '<ul class="period-list">'+
                                       str_ma_career +
                                    '</ul>'+
                                '</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td class="label">자격증</td>'+
                                '<td class="value">'+
                                    '<ul class="period-list">'+
                                        str_ma_certi +
                                    '</ul>'+
                                '</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td colspan="2" class="label">자기소개</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td colspan="2" class="value introduce">'+info.ma_desc+'</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td colspan="2" class="value">'+
                                    '<div class="hashtag">'+
                                        str_ma_type +
                                    '</div>'+
                                '</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td colspan="2" class="label">첨부사진</td>'+
                            '</tr>'+
                            '<tr>'+
                                '<td colspan="2" class="value">'+
                                   str_img +
                                '</td>'+
                            '</tr>'+
                        '</tbody>'+
                    '</table>'+
                '</div>',
            firstButton: '정보수정',
            secondButton: '가입완료',
            firstCallback: function () {

            },
            secondCallback: function () {
				var params = {};
				params["ma_type"] = "MEM";
				params["proc_type"] = "ALL";
				params["uuid"] = "<?=$uuid?>";
	            comAjax("/member_proc/join_complete_proc",params,function(ret){
	                if(ret.code=="00"){
	                    location.href="/member/join_mem_finish";
	                }else{
	                    commonAlert(ret.msg,function(){});
	                    return;
	                }
	            });
            }
        });
    }
</script>
