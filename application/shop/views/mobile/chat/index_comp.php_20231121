<script>
	//방생성 확인 및 방번호 확인
    function room_insert_return(data) {
    	var ret = JSON.parse(data);
        //채팅방 실시간 쏘기
        if(first_yn=="Y"){
            APP_NOWAPK.message_insert(JSON.stringify(first_message),JSON.stringify(first_users));
        }

    	if(ret.code=="00"){
    		location.href="/chat/chat_list?view=true&rm_idx=" + ret.data;
    	}else{
    		commonAlert(ret.msg,function(){});
    	}
    }
</script>

<script>
    var first_yn = "N";
    var first_message = {};
    var first_users = new Array();

	var g_rm_type = "recruit";
	var g_rc_idx = 0;
	var g_ru_idx = 0;
	var g_td_idx = 0;

    //룸생성처리
    $(document).on("click",".btn-view-chat",function(){
        first_yn = "N";
        var target_id = $(this).data("target_id");
        var user_id = $(this).data("user_id");
        var target_img = $(this).data("target_img");
        var user_img = $(this).data("user_img");
        var target_name = $(this).data("target_name");
        var user_name = $(this).data("user_name");
        var subject = $(this).data("subject");

        //키값 설정
        g_rc_idx = $(this).data("rc_idx");
        g_ru_idx = $(this).data("ru_idx");

        var params = {};
		params["rm_type"] = g_rm_type;
	    params["rc_idx"] = g_rc_idx;
	    params["ru_idx"] = g_ru_idx;
	    params["td_idx"] = g_td_idx;

		comAjax("/chat_proc/insert_room_check",params,function(chk){
			if(chk.code =="10"){
				commonAlert(chk.msg,function(){});
				return;
			}

			if(chk.code =="90"){
				openPopup('confirm', {
		            content: "포인트가 부족합니다.<br/><em>포인트 구매</em>를 하시겠습니까?",
		            secondCallback: function () {
		                location.href("/compage/point_charge_step1");
		            }
		        });
				return;
			}

			if(chk.data.first_yn=="Y"){
				openPopup('confirm', {
		            content: '1:1채팅시 <em>-'+chat_point+'</em>포인트가 차감됩니다.<br> 채팅을 진행하시겠습니까?',
		            secondCallback: function () {
		                comAjax("/chat_proc/insert_room",params,function(ret2){
					        if(ret2.code=="00"){
					        	var chat_suer = [];
						        chat_suer.push({user_id : user_id,img : user_img,user_name : user_name});
						        chat_suer.push({user_id : target_id,img : target_img,user_name : target_name});

						        var room_info = {
						            user_id : user_id,
						            user_list : chat_suer,
						            rm_idx : Number(ret2.data.rm_idx),
						            rm_type : "chat",
						            rm_img : "",
						            rm_subject : subject,
						            rm_desc : "",
						        };

				                //기본 문구 전송
				                first_yn = ret2.data.first_yn;
				                first_message = {
				                    rm_idx : Number(ret2.data.rm_idx),
				                    user_id : user_id,
				                    chat_type : "recruit",
				                    mg_type : "text",
				                    mg_text : "1:1 채팅을 시작합니다!",
				                    mg_req_dt : "",
				                    mg_img : "",
				                    mg_file : "",
				                    mg_imoti : "",
				                    mg_dt : getCurrentDate(),
				                    mg_reads : new Array(),
				                };
				                first_message.mg_reads.push({read_yn : "Y",user_id : user_id});
				                first_message.mg_reads.push({read_yn : "N",user_id : target_id});

				                //회원정보
				                first_users.push({user_id : user_id,user_nick : user_name});
				                first_users.push({user_id : target_id,user_nick : target_name});

				                //방생성
				                click_type = "chat";
						        APP_NOWAPK.room_insert(JSON.stringify(room_info));
					        }else{
					            commonAlert(ret2.msg,function(){});
					            return;
					        }
					    });
		            }
		        });
			}else{
				comAjax("/chat_proc/insert_room",params,function(ret2){
			        if(ret2.code=="00"){
			        	var chat_suer = [];
				        chat_suer.push({user_id : user_id,img : user_img,user_name : user_name});
				        chat_suer.push({user_id : target_id,img : target_img,user_name : target_name});

				        var room_info = {
				            user_id : user_id,
				            user_list : chat_suer,
				            rm_idx : Number(ret2.data.rm_idx),
				            rm_type : "chat",
				            rm_img : "",
				            rm_subject : subject,
				            rm_desc : "",
				        };

		                //기본 문구 전송
		                first_yn = ret2.data.first_yn;
		                first_message = {
		                    rm_idx : Number(ret2.data.rm_idx),
		                    user_id : user_id,
		                    chat_type : "recruit",
		                    mg_type : "text",
		                    mg_text : "1:1 채팅을 시작합니다!",
		                    mg_req_dt : "",
		                    mg_img : "",
		                    mg_file : "",
		                    mg_imoti : "",
		                    mg_dt : getCurrentDate(),
		                    mg_reads : new Array(),
		                };
		                first_message.mg_reads.push({read_yn : "Y",user_id : user_id});
		                first_message.mg_reads.push({read_yn : "N",user_id : target_id});

		                //회원정보
		                first_users.push({user_id : user_id,user_nick : user_name});
		                first_users.push({user_id : target_id,user_nick : target_name});

		                //방생성
		                click_type = "chat";
				        APP_NOWAPK.room_insert(JSON.stringify(room_info));
			        }else{
			            commonAlert(ret2.msg,function(){});
			            return;
			        }
			    });
			}
		});
    });
</script>
<?php else: ?>
<script>
    /*
    //뒤로왔을때 상품 유지
    window.addEventListener('pageshow', function (event) {
        alert('뒤로가기 캐치');
        location.reload();
        if (event.persisted || window.performance && window.performance.navigation.type == 2) {
            alert('뒤로가기 캐치');
        }
    }, false);
    */
    window.onpageshow = function(event) {
      // 앞/뒤로가기 버튼 클릭 시
      if (
        window.performance &&
        window.performance.navigation &&
        window.performance.navigation.type == 2
      ) {
        // 처리 로직
        alert('111');
      }
    };

        window.onpageshow = function(event) {
      // BFCache를 통해 페이지 접근할 경우
      if (event.persisted) {
          alert('22');
        window.location.reload(); // 페이지 새로고침
      }
    };

	//방생성 확인 및 방번호 확인
    socket.on("room_insert_return", function(ret) {
        //채팅방 실시간 쏘기
        if(first_yn=="Y"){
            socket.emit("message_insert",first_message,first_users);
        }

    	if(ret.code=="00"){
    		location.href="/chat/chat_list?view=true&rm_idx=" + ret.data;
    	}else{
    		commonAlert(ret.msg,function(){});
    	}
    });
</script>

