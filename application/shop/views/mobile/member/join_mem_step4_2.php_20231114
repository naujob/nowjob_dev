<div class="page page-join member-type1">
    <div class="top-bar">
        <a href="#" class="btn-back"><span class="sr-text">이전으로</span></a>
        <h1 class="title">개인회원 회원가입</h1>
        <a href="#" aria-describedby="skipTooltip" class="action js-toggle-tooltip">건너뛰기</a>
        <!-- 툴팁내용 -->
        <div role="tooltip" id="skipTooltip" class="tooltip center">
            <strong>건너뛰기를 하셨네요?</strong><br>
            정보를 입력하시면 나에게 맞는 채용을<br> 더 쉽게 찾으실 수 있습니다
        </div>
    </div><!-- //top-bar -->
    <div class="page-content">
        <div class="container">

            <ol class="progress-steps">
                <li>1</li>
                <li title="헌재위치" class="active">2</li>
                <li>3</li>
                <li>4</li>
            </ol>

            <div class="addition-info-form">
                <form id="frm" onsubmit="return false">
                    <input type="hidden" name="proc_type" value="join_mem_step4_2" />
                    <div class="form-row">

                        <p class="form-label">근무시작일</p>
                        <div class="calendar">
                            <div class="js-datepicker"></div>
                            <input type="hidden" name="ma_work_dt" aria-required="true" required class="js-date-value" value="<?=$info["ma_work_dt"]?>">
                        </div>

                        <script>
                            (function () {
                                function chgMonth (instance) {
                                    var $con = instance.calendarContainer.querySelector('.flatpickr-month'),
                                        month = Number(instance.currentMonth) + 1,
                                        year = instance.currentYear;
                                    $con.innerHTML = '<span class="month">' + month + '<small>월</small></span><span class="year">' + year + '</span>';
                                }

                                window.addEventListener('DOMContentLoaded', function () {
                                    if (typeof flatpickr == 'undefined') return false;

                                    //달력 생성
                                    flatpickr('.js-datepicker', {
                                        inline: true,
                                        locale: 'ko',
                                        dateFormat: 'Y-m-d',
                                        ariaDateFormat: 'Y-m-d',
                                        defaultDate : '<?=$info["ma_work_dt"]?>',
                                        nextArrow: '<span class="sr-text">다음</span>',
                                        prevArrow: '<span class="sr-text">이전</span>',
                                        disableMobile: true,
                                        onChange: function (selectedDates, dateStr, instance) {
                                            document.querySelector('.js-date-value').value = dateStr;
                                        },
                                        onMonthChange: function (selectedDates, dateStr, instance) {
                                            chgMonth(this);
                                        },
                                        onDayCreate: function(dObj, dStr, fp, dayElem){
                                            var day = new Date(dayElem.getAttribute('aria-label')).getDay();
                                            if (day == 0) {
                                                dayElem.classList.add('sun');
                                            } else if (day == 6) {
                                                dayElem.classList.add('sat');
                                            }
                                        },
                                        onReady: function () {
                                            chgMonth(this);
                                        }
                                    });
                                });
                            }());
                        </script>
                    </div>

                    <div class="form-row">
                        <p class="form-label">최종학력</p>
                        <div class="form-toggle-group col-4">
                            <?php foreach($ma_edu_list as $row) : ?>
                            <label class="form-toggle-btn2">
                                <input type="radio" name="ma_edu" value="<?=$row["cd_val"]?>"  <?=equal_return($row["cd_val"],$info["ma_edu"],"check")?>>
                                <span class="btn"><?=$row["cd_val"]?></span>
                            </label>
                            <?php endforeach;?>
                        </div>
                    </div>

                    <div class="sticky-bottom">
                        <button id="btnPrev" type="button" class="btn btn-secondary">이전</button>
                        <button id="btnStep" type="button" class="btn btn-primary">다음</button>
                    </div>

                </form>
            </div>

        </div>
    </div><!-- //page-content -->
</div>
<script>
    /* 건너뛰기 이동 전 툴팁표시 */
    document.querySelector('.js-toggle-tooltip').addEventListener('click', function (e) {
        //if (document.querySelector('#skipTooltip').classList.contains('on')) {
        //    location.href = this.getAttribute('href');
        //}
    });
</script>

<script>
	$(document).ready(function(){
		//건너띄기
		$(".js-toggle-tooltip").click(function(){
			setTimeout(function(){
				var params = {};
				params["ma_type"] = "MEM";
				params["proc_type"] = "PART";
				params["uuid"] = "<?=$uuid?>";
	            comAjax("/member_proc/join_complete_proc",params,function(ret){
	                if(ret.code=="00"){
	                    location.href="/member/join_mem_finish";
	                }else{
	                    commonAlert(ret.msg,function(){});
	                    return;
	                }
	            });
            },5000);
		});
		
		$("#btnStep").click(function(){
            if($("[name='ma_work_dt']").val()==""){
                commonAlert("근무가능일을 선택해주세요.",function(){});
                return;
            }

            if($("[name='ma_edu']").is(":checked")==false){
                commonAlert("최종학력을 선택해주세요.",function(){});
                return;
            }

            var params = $("#frm").serialize();
            comAjax("/member_proc/join_mem_step4_2",params,function(ret){
                if(ret.code=="00"){
                    location.href="/member/join_mem_step4_3";
                }else{
                    commonAlert(ret.msg,function(){});
                    return;
                }
            });
		});

		$("#btnPrev").click(function(){
			history.go(-1);
		});
	});
</script>
