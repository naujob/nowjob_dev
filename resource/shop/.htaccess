# 정적 디자인 자산(css/js/img/font) 캐시 설정
# 적용 범위: /resource/shop/ 이하만. 사용자 업로드(/resource/uploads/)와 관리자(/resource/admin/)는 영향 없음.
#
# css/js는 "?vs= 가 붙은 요청만" 장기 캐시하고, 버전 없는 요청은 1시간만 캐시한다.
# 현재 application/ 아래 모든 css/js 참조는 getCachCss()/getCashJs()를 거쳐 ?vs=가 붙는다.
# 이 조건 분기는 안전장치다 — 나중에 누군가 버전 없이 <link>/<script>를 직접 넣더라도
# 1년 immutable로 얼어붙지 않고 1시간 뒤 갱신되므로 .htaccess를 고칠 필요가 없다.

<IfModule mod_expires.c>
  ExpiresActive On

  # 이미지 — 주소에 버전이 없으므로 30일.
  # 이미지를 교체할 때는 파일명을 바꾸거나, 30일간 기존 사용자에게 예전 이미지가 보일 수 있음을 감안할 것.
  ExpiresByType image/png                 "access plus 30 days"
  ExpiresByType image/jpeg                "access plus 30 days"
  ExpiresByType image/gif                 "access plus 30 days"
  ExpiresByType image/webp                "access plus 30 days"
  ExpiresByType image/svg+xml             "access plus 30 days"
  ExpiresByType image/x-icon              "access plus 30 days"

  # 폰트 — 교체 시 파일명이 바뀌므로 장기 캐시 안전
  ExpiresByType font/woff                 "access plus 1 year"
  ExpiresByType font/woff2                "access plus 1 year"
  ExpiresByType application/font-woff     "access plus 1 year"
  ExpiresByType application/font-woff2    "access plus 1 year"

  # css/js는 아래 mod_headers에서 ?vs= 유무로 나눠 처리하므로 여기서 다루지 않는다.
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(css|js)$">
    # 기본값: 버전 없이 불린 파일 — 짧게만 캐시해서 수정이 하루 안에 반영되게 함
    Header set Cache-Control "public, max-age=3600"
    # ?vs= 가 붙은 요청만 장기 캐시. 파일이 바뀌면 vs 값이 바뀌어 주소가 달라지므로 immutable이 안전하다.
    Header set Cache-Control "public, max-age=31536000, immutable" "expr=%{QUERY_STRING} =~ /(^|&)vs=/"
  </FilesMatch>

  <FilesMatch "\.(png|jpe?g|gif|webp|svg|ico)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>

  <FilesMatch "\.(woff2?|ttf|eot)$">
    Header set Cache-Control "public, max-age=31536000"
  </FilesMatch>
</IfModule>
