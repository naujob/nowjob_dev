<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# index.php 직접 요청은 그대로 처리
RewriteRule ^index\.php$ - [L]

# ACME 인증 경로
RewriteRule ^\.well-known/ - [L]

# 검색엔진/광고 파일은 rewrite 제외
RewriteRule ^(ads\.txt|robots\.txt|sitemap\.xml)$ - [L]

# 실제 파일/디렉터리는 그대로 서빙
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# 나머지는 모두 프론트 컨트롤러로 전달
RewriteRule ^ index.php [L,QSA]
</IfModule>
